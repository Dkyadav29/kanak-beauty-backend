# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
TIME_ZONE=Asia/Kolkata

# --- MariaDB --------------------------------------------------------------
# Create the database and least-privilege user with scripts/mariadb_setup.sql
DB_NAME=kanak_academy
DB_USER=kanak
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_kanak_academy
DB_CONN_MAX_AGE=60

# --- JWT ------------------------------------------------------------------
JWT_SIGNING_KEY=replace-with-a-different-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Frontend / CORS ------------------------------------------------------
PUBLIC_SITE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Payments -------------------------------------------------------------
# "sandbox" enables POST /api/v1/payments/sandbox/complete for local testing.
# Production must set a real provider name; the sandbox endpoint is then disabled.
PAYMENT_GATEWAY=sandbox
PAYMENT_WEBHOOK_SECRET=replace-with-gateway-webhook-secret
PAYMENT_PENDING_REUSE_MINUTES=30

# --- Live classes / media -------------------------------------------------
LIVE_PROVIDER=internal
SIGNED_URL_TTL_MINUTES=30

# --- Auth flows -----------------------------------------------------------
OTP_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@kanakacademy.example

# --- Identifiers ----------------------------------------------------------
CERTIFICATE_NUMBER_PREFIX=KBA
ORDER_ID_PREFIX=KBA-ORD

# --- Tests ----------------------------------------------------------------
# Tests use MariaDB by default (needs CREATE on DB_TEST_NAME). Set to 1 only for
# quick local iteration without MariaDB.
TEST_DB_SQLITE=0
